<div id="<%= dom_id shipment %>">
  <table>
    <tbody>
      <tr><th>出荷日</th><td><%= ja_date(shipment.shipped_at) %></td></tr>
      <tr><th>出荷頭数</th><td><%= shipment.count %></td></tr>
      <tr><th>平均体重（kg）</th><td><%= shipment.avg_weight %></td></tr>
      <tr><th>出荷先</th><td><%= shipment.destination %></td></tr>
    </tbody>
  </table>
</div>
