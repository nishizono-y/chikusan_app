<%= form_with(model: shipment) do |form| %>
  <div class="form-group">
    <%= form.label :shipped_at %>
    <%= form.date_field :shipped_at %>
    <% shipment.errors.where(:shipped_at).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :count %>
    <%= form.number_field :count, min: 1, placeholder: "例：10" %>
    <% shipment.errors.where(:count).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :avg_weight %>
    <%= form.number_field :avg_weight, step: 0.1, min: 0.1, placeholder: "例：110" %>
    <% shipment.errors.where(:avg_weight).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :destination %>
    <%= form.text_field :destination, placeholder: "例：鹿児島食肉センター" %>
    <% shipment.errors.where(:destination).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
