<%= form_with(model: shipment) do |form| %>
  <% if shipment.errors.any? %>
    <div id="error_explanation">
      <h2><%= shipment.errors.count %>件のエラーがあります</h2>
      <ul>
        <% shipment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :shipped_at %>
    <%= form.date_field :shipped_at %>
  </div>

  <div class="form-group">
    <%= form.label :count %>
    <%= form.number_field :count, min: 0, placeholder: "例：10" %>
  </div>

  <div class="form-group">
    <%= form.label :avg_weight %>
    <%= form.number_field :avg_weight, step: 0.1, min: 0, placeholder: "例：110" %>
  </div>

  <div class="form-group">
    <%= form.label :destination %>
    <%= form.text_field :destination, placeholder: "例：鹿児島食肉センター" %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
