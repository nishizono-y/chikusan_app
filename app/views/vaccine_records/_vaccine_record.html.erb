<tr id="<%= dom_id(vaccine_record) %>">
  <td><%= ja_date_full(vaccine_record.vaccinated_on) %></td>
  <td><%= vaccine_record.head_count ? "#{vaccine_record.head_count}頭" : "—" %></td>
  <td>
    <% if vaccine_record.next_due_on.present? %>
      <%= ja_date_full(vaccine_record.next_due_on) %>
    <% else %>
      —
    <% end %>
  </td>
  <td><%= render "vaccine_records/status_badge", vaccine_record: vaccine_record, latest_vaccine_ids: local_assigns[:latest_vaccine_ids] %></td>
  <td><%= link_to "詳細", vaccine_record %></td>
</tr>
