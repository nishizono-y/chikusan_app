<% content_for :title, "接種記録 詳細" %>

<h2 class="page-title">接種記録 詳細</h2>

<div class="list-actions">
  <%= link_to vaccine_records_path, class: "btn btn-secondary btn-sm" do %>
    <i class="fa-solid fa-arrow-left"></i> 一覧に戻る
  <% end %>
  <div class="page-title-actions">
    <%= link_to edit_vaccine_record_path(@vaccine_record), class: "btn btn-secondary btn-sm" do %>
      <i class="fa-solid fa-pen"></i> 編集
    <% end %>
    <%= button_to @vaccine_record, method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "削除しますか？" } do %>
      <i class="fa-solid fa-trash"></i> 削除
    <% end %>
  </div>
</div>

<div class="card">
  <table>
    <tbody>
      <tr><th>ワクチン名</th><td><%= @vaccine_record.vaccine_name %></td></tr>
      <tr><th>接種日</th><td><%= ja_date_full(@vaccine_record.vaccinated_on) %></td></tr>
      <tr><th>対象頭数</th><td><%= @vaccine_record.head_count ? "#{@vaccine_record.head_count}頭" : "—" %></td></tr>
      <tr>
        <th>次回接種予定日</th>
        <td><%= @vaccine_record.next_due_on.present? ? ja_date_full(@vaccine_record.next_due_on) : "—" %></td>
      </tr>
      <tr><th>備考</th><td><%= @vaccine_record.notes %></td></tr>
    </tbody>
  </table>
</div>
