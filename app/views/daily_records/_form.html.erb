<%= form_with(model: daily_record) do |form| %>
  <div class="form-group">
    <%= form.label :date %>
    <%= form.date_field :date %>
    <% daily_record.errors.where(:date).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div data-controller="livestock-unit">
    <div class="form-group">
      <%= form.label :livestock_type_id %>
      <%= form.select :livestock_type_id,
            options_for_select(LivestockType.order(:name).map { |lt| [ lt.name, lt.id, { data: { unit: lt.unit } } ] }, daily_record.livestock_type_id),
            { include_blank: "選択してください" },
            { data: { livestock_unit_target: "select", action: "change->livestock-unit#updateUnit" } } %>
      <% daily_record.errors.where(:livestock_type).each do |error| %>
        <span class="field-error"><%= error.full_message %></span>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :head_count do %>
        <%= DailyRecord.human_attribute_name(:head_count) %><span class="unit-badge" data-livestock-unit-target="unit"></span>
      <% end %>
      <%= form.number_field :head_count, min: 0 %>
      <% if local_assigns[:auto_calculated_head_count] %>
        <span class="field-hint">前日の記録から自動計算しました</span>
      <% end %>
      <% daily_record.errors.where(:head_count).each do |error| %>
        <span class="field-error"><%= error.full_message %></span>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :death_count do %>
        <%= DailyRecord.human_attribute_name(:death_count) %><span class="unit-badge" data-livestock-unit-target="unit"></span>
      <% end %>
      <%= form.number_field :death_count, min: 0 %>
      <% daily_record.errors.where(:death_count).each do |error| %>
        <span class="field-error"><%= error.full_message %></span>
      <% end %>
    </div>
  </div>

  <div data-controller="feed-stock"<% unless local_assigns[:prev_feed_stock].nil? %> data-feed-stock-prev-stock-value="<%= local_assigns[:prev_feed_stock] %>"<% end %>>
    <div class="form-group">
      <%= form.label :feed_usage %>
      <%= form.number_field :feed_usage, min: 0, autocomplete: "off",
            data: { feed_stock_target: "usage", action: "input->feed-stock#calculate change->feed-stock#calculate" } %>
      <% daily_record.errors.where(:feed_usage).each do |error| %>
        <span class="field-error"><%= error.full_message %></span>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :feed_stock %>
      <%= form.number_field :feed_stock, min: 0,
            data: { feed_stock_target: "stock" } %>
      <% unless local_assigns[:prev_feed_stock].nil? %>
        <span class="field-hint">飼料使用量を入力すると自動計算されます（前日残量: <%= local_assigns[:prev_feed_stock] %>）</span>
      <% end %>
      <% daily_record.errors.where(:feed_stock).each do |error| %>
        <span class="field-error"><%= error.full_message %></span>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :vaccine %>
    <%= form.select :vaccine, DailyRecord::VACCINE_OPTIONS, { include_blank: "選択してください" } %>
    <% daily_record.errors.where(:vaccine).each do |error| %>
      <span class="field-error"><%= error.full_message %></span>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :memo %>
    <%= form.text_area :memo, placeholder: "体調・気になることを記入してください" %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
