<% content_for :title, "日次記録 詳細" %>

<h2 class="page-title">日次記録 詳細</h2>

<div class="list-actions">
  <%= link_to daily_records_path(month: daily_record_month), class: "btn btn-secondary btn-sm" do %>
    <i class="fa-solid fa-arrow-left"></i> 一覧に戻る
  <% end %>
  <div class="page-title-actions">
    <%= link_to edit_daily_record_path(@daily_record), class: "btn btn-secondary btn-sm" do %>
      <i class="fa-solid fa-pen"></i> 編集
    <% end %>
    <%= button_to @daily_record, method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "本当に削除しますか？" } do %>
      <i class="fa-solid fa-trash"></i> 削除
    <% end %>
  </div>
</div>

<div class="card">
  <%= render @daily_record %>
</div>
