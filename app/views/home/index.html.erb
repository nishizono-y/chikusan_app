<% content_for :title, "ホーム" %>

<% if @weather&.heat_stress? %>
  <div class="alert-bar alert-bar--heat">
    <i class="fa-solid fa-temperature-high"></i>
    気温 <%= @weather.temp %>℃ — <strong>熱ストレス注意</strong>（家畜の状態を確認してください）
  </div>
<% end %>

<% if @vaccine_alerts.any? %>
  <% @vaccine_alerts.each do |vr| %>
    <div class="alert-bar alert-bar--vaccine">
      <i class="fa-solid fa-syringe"></i>
      <%= vr.vaccine_name %>の次回接種予定：<%= ja_date_full(vr.next_due_on) %>
      <% if vr.overdue? %>
        <strong>（期限切れ）</strong>
      <% elsif vr.due_soon? %>
        <strong>（まもなく期限）</strong>
      <% end %>
      <%= link_to "詳細", vaccine_records_path, class: "alert-link" %>
    </div>
  <% end %>
<% end %>

<% if @feed_stock_alert %>
  <div class="alert-bar">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span>飼料残量が少なくなっています<% if @feed_remaining_days %>（残り<%= @feed_remaining_days %>日分程度）<% end %></span>
    <%= link_to "発注する", new_feed_order_path, class: "alert-link" %>
  </div>
<% elsif @feed_ordered %>
  <div class="alert-bar alert-bar--vaccine">
    <i class="fa-solid fa-circle-check"></i>
    <span>飼料は発注済みです</span>
    <%= link_to "発注履歴", feed_orders_path, class: "alert-link" %>
  </div>
<% end %>

<div class="section-label">今日の気象情報</div>
<div class="card">
  <div class="card-title">
    <i class="fa-solid fa-cloud-sun"></i> 農場周辺の気象
  </div>
  <div class="summary-grid">
    <div class="<%= class_names('summary-item', warn: @weather&.heat_stress?) %>">
      <div class="summary-icon"><i class="fa-solid fa-temperature-half"></i></div>
      <div class="summary-num">
        <% if @weather %>
          <%= @weather.temp %><span class="summary-unit">℃</span>
        <% else %>
          —
        <% end %>
      </div>
      <div class="summary-label">気温</div>
    </div>
    <div class="summary-item">
      <div class="summary-icon"><i class="fa-solid fa-droplet"></i></div>
      <div class="summary-num">
        <% if @weather %>
          <%= @weather.humidity %><span class="summary-unit">%</span>
        <% else %>
          —
        <% end %>
      </div>
      <div class="summary-label">湿度</div>
    </div>
    <div class="summary-item" style="grid-column: span 2;">
      <% if @weather %>
        <% if @weather.icon_code.present? %>
          <div class="summary-icon">
            <img src="https://openweathermap.org/img/wn/<%= @weather.icon_code %>.png" alt="<%= @weather.description %>" style="width:40px;height:40px;">
          </div>
        <% end %>
        <div class="summary-num" style="font-size: 1rem;"><%= @weather.description %></div>
      <% else %>
        <div class="summary-num">—</div>
      <% end %>
      <div class="summary-label">天気</div>
    </div>
  </div>
</div>

<div class="section-label"><%= @month_label %>の状況</div>

<div class="card">
  <div class="card-title">
    <i class="fa-solid fa-chart-simple"></i> <%= @month_label %>の飼養記録
  </div>
  <div class="summary-grid">
    <div class="summary-item">
      <div class="summary-icon"><i class="fa-solid fa-pig"></i></div>
      <div class="summary-num"><%= @month_head_count || "—" %></div>
      <div class="summary-label">現在の飼養頭数</div>
    </div>
    <div class="<%= class_names('summary-item', warn: @month_deaths > 0) %>">
      <div class="summary-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
      <div class="summary-num"><%= @month_deaths %></div>
      <div class="summary-label">今月の死亡頭数</div>
    </div>
    <div class="summary-item">
      <div class="summary-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
      <div class="summary-num"><%= @month_ship_count %></div>
      <div class="summary-label">今月の出荷頭数</div>
    </div>
    <div class="summary-item">
      <div class="summary-icon"><i class="fa-solid fa-wheat-awn"></i></div>
      <div class="summary-num"><%= number_with_delimiter(@month_feed_usage) %><span class="summary-unit">kg</span></div>
      <div class="summary-label">飼料使用量</div>
    </div>
  </div>
</div>

<div class="section-label">今月の直近記録</div>

<div class="card">
  <div class="card-title">
    <i class="fa-solid fa-clock-rotate-left"></i> 今月の直近3件
  </div>
  <% if @recent_records.any? %>
    <% @recent_records.each do |record| %>
      <% death_count = record.death_count.to_i %>
      <div class="record-item">
        <div>
          <div class="record-date">
            <%= ja_date(record.date) %>
          </div>
          <div class="record-main">
            死亡 <%= death_count %>頭・飼料 <%= record.feed_usage.to_i %>kg
          </div>
        </div>
        <% if death_count > 0 %>
          <div class="record-badge badge-ng">
            <i class="fa-solid fa-circle-exclamation"></i> 要確認
          </div>
        <% else %>
          <div class="record-badge badge-ok">
            <i class="fa-solid fa-circle-check"></i> 異常なし
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="empty-message">今月はまだ記録がありません</p>
  <% end %>
</div>

<div class="section-label">過去6ヶ月の推移</div>

<div class="card">
  <div class="card-title">
    <i class="fa-solid fa-chart-line"></i> 飼養頭数の推移
  </div>
  <% if @chart_head_count.any? { |_, v| v } %>
    <%= line_chart @chart_head_count,
          height: "160px",
          colors: ["#4a7c59"],
          library: {
            scales: { y: { beginAtZero: false, ticks: { stepSize: 1 } } },
            plugins: { legend: { display: false } }
          } %>
  <% else %>
    <p class="empty-message">グラフを表示するデータがありません</p>
  <% end %>

  <div class="card-title" style="margin-top: 1rem;">
    <i class="fa-solid fa-chart-column"></i> 死亡頭数の推移（月次合計）
  </div>
  <% if @chart_death_count.any? { |_, v| v > 0 } %>
    <%= bar_chart @chart_death_count,
          height: "160px",
          colors: ["#c0392b"],
          library: {
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
            plugins: { legend: { display: false } }
          } %>
  <% else %>
    <p class="empty-message">グラフを表示するデータがありません</p>
  <% end %>
</div>

<div class="actions">
  <%= link_to report_path, class: "btn btn-report" do %>
    <i class="fa-solid fa-file-lines"></i> 月次報告を見る
  <% end %>
</div>
